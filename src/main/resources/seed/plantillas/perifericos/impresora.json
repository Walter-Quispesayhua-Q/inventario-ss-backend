      },
      {
        "nombre": "BONUS_TIENE_VELOCIDAD_TERMICA",
        "condicion": ".*\\b\\d+\\s*mm/s.*",
        "puntos": 0.08,
        "descripcion": "Se encontró velocidad térmica en mm/s"
      },
      {
        "nombre": "BONUS_TICKETERA",
