"""
Niveles de notificación para respuestas de operaciones.
Útil para que el frontend muestre alertas con colores apropiados.
"""
enum NivelNotificacion {
    INFO
    SUCCESS
    WARNING
    ERROR
}

"""
Respuesta estándar para operaciones sobre bienes.
"""
type OperacionResultadoBien {
    exito: Boolean!
    mensaje: String!
    nivel: NivelNotificacion!
    data: BienDTO
    timestamp: DateTime!
}

"""
Respuesta estándar para operaciones sobre usuarios.
"""
type OperacionResultadoUsuario {
    exito: Boolean!
    mensaje: String!
    nivel: NivelNotificacion!
    data: UsuarioDTO
    timestamp: DateTime!
}

"""
Respuesta estándar para operaciones de login.
"""
type OperacionResultadoLoginUsuario {
    exito: Boolean!
    mensaje: String!
    nivel: NivelNotificacion!
    data: UsuarioLoginResponseDTO
    timestamp: DateTime!
}

